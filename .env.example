# Скопируй файл в .env и заполни облачными значениями. .env не коммитится.
# Если .env отсутствует, для локальной Docker-эмуляции используется local-emulation.env.

MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=real_estate_price_improvement
MLFLOW_MODEL_NAME=real_estate_price_model

MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://MLFLOW_USER:MLFLOW_PASSWORD@MLFLOW_HOST:5432/MLFLOW_DATABASE

# S3 Yandex Cloud: s3://ИМЯ_БАКЕТА/mlflow
MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://YOUR_BUCKET_NAME/mlflow
MLFLOW_S3_ENDPOINT_URL=https://storage.yandexcloud.net
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY

# Локальные файлы из предыдущего проекта
DATA_PATH=data/initial_data.csv
BASELINE_MODEL_PATH=baseline/model.pkl
BASELINE_METRICS_PATH=baseline/metrics.json

# Ресурсы экспериментов. Для сдачи рекомендуется FAST_RUN=false.
FAST_RUN=false
RANDOM_STATE=42
