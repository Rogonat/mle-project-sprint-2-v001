# Локальная эмуляция ВМ через docker-compose.yml. Для Yandex Cloud создай .env с облачными значениями.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=real_estate_price_improvement
MLFLOW_MODEL_NAME=real_estate_price_model

MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://mlflow:mlflow@127.0.0.1:5433/mlflowdb
MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://mlflow-artifacts/mlflow
MLFLOW_S3_ENDPOINT_URL=http://127.0.0.1:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

DATA_PATH=data/initial_data.csv
BASELINE_MODEL_PATH=baseline/model.pkl
BASELINE_METRICS_PATH=baseline/metrics.json

FAST_RUN=false
RANDOM_STATE=42
